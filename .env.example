# Copy this file to .env and fill in your own value. .env is git-ignored.
# Google OAuth client ID for Drive sync. Not a secret (it ships in the built page), but it is
# kept out of the repo so each deployment can use its own client.
# Google Cloud Console -> Google Auth Platform -> Clients -> create a "Web application" client.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
